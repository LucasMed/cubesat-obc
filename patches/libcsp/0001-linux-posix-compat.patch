-#include <csp/csp_debug.h>
-#else
-#include <sys/reboot.h>
 #include <linux/reboot.h>
+#include <unistd.h>
 #endif
 
-uint32_t csp_memfree_hook(void) {
-	uint32_t total = 0;
-	struct sysinfo info;
-	sysinfo(&info);
-	total = info.freeram * info.mem_unit;
-	return total;
+/* -----------------------------------------------------------
+ * Host / macOS compatible system layer
+ * ----------------------------------------------------------- */
+
+int csp_sys_tasklist(char * out) {
+	(void)out;
+	return CSP_ERR_NONE;
 }
 
-unsigned int csp_ps_hook(csp_packet_t * packet) {
-	(void)packet; /* Avoid compiler warnings about unused parameter */
+int csp_sys_memfree(void) {
+
+#ifdef __linux__
+	struct sysinfo info;
+	if (sysinfo(&info) == 0) {
+		return info.freeram;
+	}
+#endif
+
+	/* macOS / host simulation */
 	return 0;
 }
 
-void csp_reboot_hook(void) {
-#ifdef __CYGWIN__
-    csp_print("HALTED - Please reboot\n");
-    while (true)
-        sleep(1);
-#else
-	sync();
-	reboot(LINUX_REBOOT_CMD_RESTART);
+int csp_sys_uptime(void) {
+
+#ifdef __linux__
+	struct sysinfo info;
+	if (sysinfo(&info) == 0) {
+		return info.uptime;
+	}
 #endif
+
+	/* fallback */
+	return (int)time(NULL);
 }
 
-void csp_shutdown_hook(void) {
-#ifdef __CYGWIN__
-    csp_print("HALTED - Please power off\n");
-    while (true)
-        sleep(1);
+void csp_sys_reboot(void) {
+
+#ifdef __linux__
+	reboot(LINUX_REBOOT_CMD_RESTART);
 #else
-	sync();
+	/* Host simulation: just exit */
+	exit(0);
+#endif
+}
+
+void csp_sys_shutdown(void) {
+
+#ifdef __linux__
 	reboot(LINUX_REBOOT_CMD_HALT);
+#else
+	exit(0);
 #endif
 }
