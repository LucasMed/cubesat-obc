diff --git a/src/arch/posix/csp_semaphore.c b/src/arch/posix/csp_semaphore.c
index 861ed0f6..369901f8 100644
--- a/src/arch/posix/csp_semaphore.c
+++ b/src/arch/posix/csp_semaphore.c
@@ -9,7 +9,7 @@
 
 void csp_bin_sem_init(csp_bin_sem_t * sem) {
 
-	sem_init((sem_t *) sem, 0, 1);
+	sem_init((sem_t *)sem, 0, 1);
 }
 
 int csp_bin_sem_wait(csp_bin_sem_t * sem, unsigned int timeout) {
@@ -17,7 +17,7 @@ int csp_bin_sem_wait(csp_bin_sem_t * sem, unsigned int timeout) {
 	int ret;
 
 	if (timeout == CSP_MAX_TIMEOUT) {
-		ret = sem_wait((sem_t *) sem);
+		ret = sem_wait((sem_t *)sem);
 	} else {
 		struct timespec ts;
 		if (clock_gettime(CLOCK_REALTIME, &ts)) {
@@ -35,7 +35,33 @@ int csp_bin_sem_wait(csp_bin_sem_t * sem, unsigned int timeout) {
 
 		ts.tv_nsec = (ts.tv_nsec + nsec) % 1000000000;
 
-		ret = sem_timedwait((sem_t *) sem, &ts);
+#ifdef __APPLE__
+
+		/* macOS has no sem_timedwait.
+		 * Emulate with polling + nanosleep.
+		 */
+		while (1) {
+			if (sem_trywait((sem_t *)sem) == 0) {
+				ret = 0;
+				break;
+			}
+
+			struct timespec sleep_ts = {0, 1000000};  // 1 ms
+			nanosleep(&sleep_ts, NULL);
+
+			struct timespec now;
+			clock_gettime(CLOCK_REALTIME, &now);
+
+			if ((now.tv_sec > ts.tv_sec) ||
+				(now.tv_sec == ts.tv_sec && now.tv_nsec >= ts.tv_nsec)) {
+				ret = -1;
+				break;
+			}
+		}
+
+#else
+		ret = sem_timedwait((sem_t *)sem, &ts);
+#endif
 	}
 
 	if (ret != 0)
@@ -47,12 +73,12 @@ int csp_bin_sem_wait(csp_bin_sem_t * sem, unsigned int timeout) {
 int csp_bin_sem_post(csp_bin_sem_t * sem) {
 
 	int value;
-	sem_getvalue((sem_t *) sem, &value);
+	sem_getvalue((sem_t *)sem, &value);
 	if (value > 0) {
 		return CSP_SEMAPHORE_OK;
 	}
 
-	if (sem_post((sem_t *) sem) == 0) {
+	if (sem_post((sem_t *)sem) == 0) {
 		return CSP_SEMAPHORE_OK;
 	}
 
