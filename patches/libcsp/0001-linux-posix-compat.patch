 include/csp/csp_rtable.h        |   6 +-
 src/arch/posix/CMakeLists.txt   |   1 +
 src/arch/posix/csp_hooks.c      |  17 +++
 src/arch/posix/csp_semaphore.c  |  36 +++++-
 src/arch/posix/csp_system.c     |  75 +++++++----
 src/arch/posix/pthread_queue.c  |  10 +-
 src/csp_macro.h                 |   8 +-
 src/drivers/CMakeLists.txt      |  13 +-
 src/drivers/eth/eth_linux.c     | 222 ++++++++++++++++----------------
 src/drivers/usart/usart_linux.c |   4 +
 11 files changed, 331 insertions(+), 216 deletions(-)
 create mode 100644 src/arch/posix/csp_hooks.c

