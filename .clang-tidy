# CubeSat OBC clang-tidy configuration
# See: https://clang.llvm.org/extra/clang-tidy/
#
# Selection principles:
# - Enable path-sensitive analyzer checks (clang-analyzer-*) as Coverity alternative
# - Enable common bug pattern detection (bugprone-*)
# - Keep checks relevant for C99/C11 embedded code
# - Disable noisy / C++-only check groups

Checks: >
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  readability-*,
  misc-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-uppercase-literal-suffix,
  -readability-isolate-declaration,
  -readability-convert-member-functions-to-static,
  -readability-redundant-member-init,
  -readability-named-parameter,
  -readability-use-anyofallof,
  -bugprone-easily-swappable-parameters,
  -bugprone-implicit-widening-of-multiplication-result,
  -misc-no-recursion,
  -misc-include-cleaner,
  -misc-const-correctness,
  -misc-header-include-cycle,
  -performance-no-int-to-ptr,
  -performance-avoid-endl

CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: '50'
  - key: bugprone-reserved-identifier.AggressiveDependentMemberLookup
    value: 'false'
  - key: performance-unnecessary-value-param.Threshold
    value: '64'

WarningsAsErrors: "*"
HeaderFilterRegex: ".*"
FormatStyle: none
